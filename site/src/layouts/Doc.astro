---
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import icon from '../../../extension/icons/icon128.png';

interface Props {
  title: string;
  description: string;
  source: string;
}
const { title, description, source } = Astro.props;
const REPO = 'https://github.com/jnahian/veil-chrome-ext';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={title} description={description}>
  <header class="border-b border-line">
    <nav class="mx-auto flex max-w-3xl items-center gap-8 px-4 py-3 sm:px-6">
      <a href={`${base}/`} class="flex min-h-11 items-center gap-2.5 text-lg font-bold">
        <Image src={icon} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" class="rounded-md" />
        Veil
      </a>
      <a href={`${base}/`} class="ml-auto py-3 text-slate-ink hover:text-ink">Back to the home page</a>
    </nav>
  </header>

  <main class="doc mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-20">
    <slot />
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-3xl flex-wrap gap-x-7 px-4 py-6 text-[15px] text-slate-ink sm:px-6">
      <span class="py-3">MIT License</span>
      <a href={`${base}/privacy/`} class="py-3 hover:text-ink">Privacy policy</a>
      <a href={`${base}/changelog/`} class="py-3 hover:text-ink">Changelog</a>
      <a href={`${REPO}/blob/main/${source}`} target="_blank" rel="noopener" class="py-3 hover:text-ink">
        View this page on GitHub
      </a>
      <a href={`${REPO}/issues`} target="_blank" rel="noopener" class="py-3 hover:text-ink">Support</a>
    </div>
  </footer>
</Layout>

<style>
  .doc :global(h1) {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .doc :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .doc :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .doc :global(p),
  .doc :global(ul) {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-slate-ink);
  }
  .doc :global(h3 + ul) {
    margin-top: 0.5rem;
  }
  .doc :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .doc :global(li + li) {
    margin-top: 0.5rem;
  }
  .doc :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .doc :global(a:hover) {
    color: var(--color-brand-deep);
  }
  .doc :global(h2 a) {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .doc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink);
  }
</style>
