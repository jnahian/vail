---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import icon from '../../../extension/icons/icon128.png';
import shotPanel from '../../../store/assets/screenshot-4-panel.png';
import shotRules from '../../../store/assets/screenshot-5-rules.png';

const REPO = 'https://github.com/jnahian/vail';
const DOWNLOAD = `${REPO}/releases/latest`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const looks = [
  { value: 'off', label: 'Off', caption: 'Without Veil, everyone on the call sees this.' },
  { value: 'mask', label: 'Mask', caption: 'Mask draws a solid bar over each match. The page itself does not change.' },
  { value: 'hide', label: 'Hide', caption: 'Hide makes each match invisible and keeps its space.' },
  { value: 'blur', label: 'Blur', caption: 'Blur softens each match. It can show clearly on hover, if you turn that on.' },
];

const stats = [
  { label: 'Balance', value: '$48,210.75' },
  { label: 'Due this month', value: '$6,904.00' },
  { label: 'Paid out this year', value: '৳ 12,48,000' },
];

const invoices = [
  { id: 'INV-2041', name: 'Maya Chen', email: 'maya@lumenbooks.example', amount: '$1,240.50' },
  { id: 'INV-2042', name: 'Rafi Ahmed', email: 'rafi@northwind.example', amount: 'Tk 58,000' },
  { id: 'INV-2043', name: 'Ola Berg', email: 'ola@fjord.example', amount: '1.240,50 €' },
  { id: 'INV-2044', name: 'Sam Ortiz', email: 'sam@ortiz.example', amount: "CHF 1'250.00" },
];

const payout = [
  { label: 'Card', value: '4242 4242 4242 4242' },
  { label: 'IBAN', value: 'DE89 3704 0044 0532 0130 00' },
  { label: 'Phone', value: '+880 1712-345678' },
  { label: 'Secret key', value: 'sk_live_51LumenExample0Key' },
  { label: 'Webhook server', value: '203.0.113.42' },
];

const types = [
  { name: 'Money', example: '$1,240.50  ₹3 lakh', rule: 'Skips version numbers, years, percentages and phone numbers.' },
  { name: 'Emails', example: 'jane@example.com', rule: 'Needs a name, an @ and a domain.' },
  { name: 'Phone numbers', example: '+880 1712-345678', rule: '9 to 15 digits. Dates and 1 234 567 style amounts are skipped.' },
  { name: 'Card numbers', example: '4242 4242 4242 4242', rule: 'Must pass the Luhn checksum that every card number has.' },
  { name: 'IBANs', example: 'DE89 3704 0044 0532 0130 00', rule: 'Must pass the IBAN checksum.' },
  { name: 'API keys', example: 'sk_live_…  ghp_…  AKIA…', rule: 'Known key formats only, also inside code elements.' },
  { name: 'IP addresses', example: '192.168.1.10', rule: 'IPv4 only.' },
  { name: 'Your own words', example: 'Project Falcon  /INV-\\d+/', rule: 'Plain text or a regular expression, one per line.' },
];

const actions = [
  {
    title: 'Blur',
    body: 'See the result while you drag the strength slider. You can have the element show clearly while you hover over it.',
  },
  { title: 'Hide', body: 'Keep the blank space, or remove the element so the page closes up around it.' },
  { title: 'Replace text', body: "Type new text directly on the page. It keeps the site's font, size and color." },
];

const shortcuts = [
  { keys: 'Alt+Shift+V', action: 'Pick an element' },
  { keys: 'Alt+Shift+X', action: 'Pause or resume all changes' },
  { keys: 'Alt+Shift+M', action: 'Show hidden data for a moment' },
];

const description =
  'A Chrome extension that masks money, emails, phone numbers, API keys and other sensitive data, and hides, blurs or rewrites any element on a page.';

// Structured data that tells search engines and AI tools what Veil is.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Veil',
  alternateName: 'Veil: Hide, Blur & Rewrite',
  description,
  url: Astro.site,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: DOWNLOAD,
  sameAs: [REPO],
};

const steps = [
  'Download the zip from the latest release, and unzip it into a folder that you keep.',
  'Open chrome://extensions and turn on Developer mode.',
  'Click Load unpacked, and select the folder that contains manifest.json.',
  'Pin Veil from the puzzle-piece menu, open a site, and click Pick an element.',
];

const h2 = 'text-4xl font-extrabold leading-[1.02] tracking-[-0.03em] text-balance sm:text-5xl';
const lead = 'text-lg leading-relaxed text-slate-ink text-pretty';
const primary =
  'inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-5 py-3 font-semibold text-white transition-colors hover:bg-brand-deep focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand motion-reduce:transition-none';
---

<Layout
  title="Veil: hide private data before you share your screen"
  {description}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="sticky top-0 z-10 border-b border-line bg-paper/85 backdrop-blur">
    <nav class="mx-auto flex max-w-7xl items-center gap-8 px-4 py-3 sm:px-6 lg:px-8">
      <a href={`${base}/`} class="flex min-h-11 items-center gap-2.5 text-lg font-bold">
        <Image src={icon} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" class="rounded-md" />
        Veil
      </a>
      <div class="ml-auto hidden items-center gap-7 text-slate-ink md:flex">
        <a href="#demo" class="hover:text-ink">Demo</a>
        <a href="#finds" class="hover:text-ink">What it hides</a>
        <a href="#pick" class="hover:text-ink">Element picker</a>
        <a href="#privacy" class="hover:text-ink">Privacy</a>
        <a href="#install" class="hover:text-ink">Install</a>
        <a href={REPO} target="_blank" rel="noopener" class="hover:text-ink">GitHub</a>
      </div>
      <a href={DOWNLOAD} target="_blank" rel="noopener" class:list={[primary, 'ml-auto px-4 py-2 text-[15px] md:ml-0']}>
        <span class="sm:hidden">Download</span><span class="hidden sm:inline">Download for Chrome</span>
      </a>
    </nav>
  </header>

  <main>
    <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8 lg:pt-20">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <h1
          class="max-w-3xl text-[clamp(3rem,7vw,5.75rem)] leading-[0.96] font-extrabold tracking-[-0.04em] text-balance"
        >
          Share your screen, not your numbers.
        </h1>
        <div class="flex max-w-md flex-col gap-6 lg:pb-2">
          <p class="text-lg leading-relaxed text-slate-ink text-pretty sm:text-xl">
            Veil is a Chrome extension that covers money, emails, card numbers and API keys on any site before anyone
            else sees them. Try it on the page below.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={DOWNLOAD} target="_blank" rel="noopener" class={primary}>Download for Chrome</a>
            <a
              href={REPO} target="_blank" rel="noopener"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-[#c9cfdc] px-5 py-3 font-semibold transition-colors hover:border-ink motion-reduce:transition-none"
            >
              View the source
            </a>
          </div>
          <p class="text-[15px] text-slate-ink">Free and open source. No account, no tracking.</p>
        </div>
      </div>

      <div class="demo mt-12 lg:mt-14">
        <div class="rounded-[20px] bg-ink p-2 shadow-[0_30px_60px_-30px_rgba(22,27,51,0.45)] sm:p-2.5">
          <div class="flex items-center gap-3 px-2 pt-1.5 pb-3 text-sm text-[#d4d8e6] sm:px-3">
            <span class="size-2.5 rounded-full bg-[#f0685b]"></span>
            <span>You are sharing this tab</span>
            <span class="ml-auto hidden rounded-md bg-[#2a3052] px-3 py-1 text-white sm:inline">Stop sharing</span>
          </div>
          <div class="flex flex-col overflow-hidden rounded-xl bg-white lg:flex-row" aria-label="Example billing page">
            <div
              class="hidden w-52 shrink-0 flex-col gap-1.5 border-r border-[#e6e9f0] bg-[#f7f8fb] px-5 py-6 text-[15px] text-slate-ink lg:flex"
            >
              <div class="mb-4 text-[17px] font-bold text-ink">Lumen Books</div>
              <div class="px-2.5 py-2">Overview</div>
              <div class="rounded-lg bg-[#e9ecf3] px-2.5 py-2 font-semibold text-ink">Billing</div>
              <div class="px-2.5 py-2">Customers</div>
              <div class="px-2.5 py-2">Settings</div>
            </div>
            <div class="flex min-w-0 grow flex-col gap-5 p-4 tabular-nums sm:p-7">
              <div class="text-2xl font-bold">Billing</div>
              <div class="grid gap-3 sm:grid-cols-3 sm:gap-4">
                {
                  stats.map((s, i) => (
                    <div class:list={["rounded-xl border border-[#e6e9f0] p-4", i > 0 && "hidden sm:block"]}>
                      <div class="text-sm text-slate-ink">{s.label}</div>
                      <div class="mt-2 text-2xl font-bold whitespace-nowrap">
                        <span class="v">{s.value}</span>
                      </div>
                    </div>
                  ))
                }
              </div>
              <table class="w-full border-collapse text-[15px]">
                <thead>
                  <tr class="border-b border-[#e6e9f0] text-left text-[13px] text-slate-ink">
                    <th class="py-2 font-medium">Customer</th>
                    <th class="hidden py-2 font-medium sm:table-cell">Invoice</th>
                    <th class="hidden py-2 font-medium md:table-cell">Email</th>
                    <th class="py-2 text-right font-medium">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    invoices.map((row) => (
                      <tr class="border-b border-[#f0f2f6] last:border-0">
                        <td class="py-3">{row.name}</td>
                        <td class="hidden py-3 sm:table-cell">{row.id}</td>
                        <td class="hidden py-3 md:table-cell">
                          <span class="v">{row.email}</span>
                        </td>
                        <td class="py-3 text-right">
                          <span class="v">{row.amount}</span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <dl
              class="flex shrink-0 flex-col gap-4 border-t border-[#e6e9f0] p-4 text-sm sm:p-7 lg:w-80 lg:border-t-0 lg:border-l"
            >
              <div class="text-[17px] font-bold">Payout details</div>
              {
                payout.map((p) => (
                  <div class="flex flex-col gap-1">
                    <dt class="text-slate-ink">{p.label}</dt>
                    <dd class="font-mono text-[15px] break-all">
                      <span class="v">{p.value}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-7">
          <fieldset class="grid grid-cols-4 gap-1 rounded-xl bg-[#e6e9f0] p-1 sm:flex">
            <legend class="sr-only">How Veil covers the data</legend>
            {
              looks.map((l) => (
                <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-[9px] px-5 font-semibold text-slate-ink transition-colors has-checked:bg-white has-checked:text-ink has-checked:shadow-sm has-focus-visible:outline-3 has-focus-visible:outline-brand motion-reduce:transition-none">
                  <input type="radio" name="look" value={l.value} checked={l.value === 'mask'} class="sr-only" />
                  {l.label}
                </label>
              ))
            }
          </fieldset>
          {
            looks.map((l) => (
              <p data-caption={l.value} class="text-slate-ink">
                {l.caption}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="demo"
      class="mx-auto flex max-w-5xl scroll-mt-20 flex-col gap-6 px-4 pt-24 sm:px-6 lg:px-8 lg:pt-36"
    >
      <div class="flex flex-col gap-5">
        <h2 class={h2}>Watch Veil in action.</h2>
        <p class:list={[lead, 'max-w-2xl']}>
          A short walkthrough of hiding sensitive data on a site, picking an element, and managing your rules.
        </p>
      </div>
      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-line bg-ink">
        <iframe
          class="h-full w-full"
          src="https://www.youtube-nocookie.com/embed/-tR-An6twFQ"
          title="Stop leaking data on screen shares - Veil for Chrome (demo)"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen></iframe>
      </div>
    </section>

    <section
      id="finds"
      class="mx-auto grid max-w-7xl scroll-mt-20 gap-10 px-4 pt-24 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:pt-36"
    >
      <div class="flex flex-col gap-5 lg:col-span-4">
        <h2 class={h2}>Turn it on once. Veil finds the rest.</h2>
        <p class={lead}>
          Switch on sensitive data for a site, and Veil covers every match on its pages, including content that loads
          later. Money is on by default. Choose the other types in the popup.
        </p>
        <p class={lead}>Press <kbd>Alt+Shift+M</kbd> to show the data again on the current tab.</p>
      </div>
      <dl class="lg:col-span-7 lg:col-start-6">
        <div
          class="hidden border-b border-[#c9cfdc] pb-3 text-sm font-medium text-slate-ink sm:grid sm:grid-cols-[10rem_16rem_1fr] sm:gap-4"
        >
          <span>Type</span><span>Example</span><span>How Veil avoids false matches</span>
        </div>
        {
          types.map((t) => (
            <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[10rem_16rem_1fr] sm:gap-4 sm:py-5">
              <dt class="text-lg font-semibold sm:text-base">{t.name}</dt>
              <dd class="font-mono text-[15px] whitespace-pre">{t.example}</dd>
              <dd class="leading-snug text-slate-ink">{t.rule}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="pick" class="mx-auto flex max-w-7xl scroll-mt-20 flex-col gap-14 px-4 pt-24 sm:px-6 lg:gap-20 lg:px-8 lg:pt-36">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <h2 class:list={[h2, 'max-w-xl']}>For everything else, point at it.</h2>
        <p class:list={[lead, 'max-w-lg']}>
          Names, addresses and customer photos have no reliable format. Pick them yourself: click the toolbar icon,
          press <kbd>Alt+Shift+V</kbd>, or right-click and choose Veil this element.
        </p>
      </div>

      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-6">
        <Image
          src={shotPanel}
          alt="The Veil panel next to a selected avatar, with the Blur strength slider open"
          class="w-full rounded-2xl border border-line lg:col-span-7"
          widths={[640, 1280]}
          sizes="(min-width: 1280px) 700px, 100vw"
        />
        <div class="flex flex-col gap-8 lg:col-span-4 lg:col-start-9">
          {
            actions.map((a) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-2xl font-bold">{a.title}</h3>
                <p class="leading-relaxed text-slate-ink">{a.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-6">
        <div class="flex flex-col gap-3 lg:col-span-4">
          <h3 class="text-3xl leading-tight font-extrabold tracking-[-0.02em]">Your changes come back on every visit</h3>
          <p class="leading-relaxed text-slate-ink">
            Apply a change to one page or to the whole site. Veil applies it again when the page loads, also on
            single-page apps. Turn rules on and off from the popup, and undo any save for 5 seconds.
          </p>
        </div>
        <Image
          src={shotRules}
          alt="The Veil popup listing three rules for the current page"
          class="w-full rounded-2xl border border-line lg:col-span-7 lg:col-start-6"
          widths={[640, 1280]}
          sizes="(min-width: 1280px) 700px, 100vw"
        />
      </div>

      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h3 class="text-2xl font-bold">Keyboard shortcuts</h3>
          <p class="mt-2 text-slate-ink">
            Change them at <span class="font-mono text-[15px]">chrome://extensions/shortcuts</span>.
          </p>
        </div>
        <ul class="divide-y divide-line border-y border-line lg:col-span-7 lg:col-start-6">
          {
            shortcuts.map((s) => (
              <li class="flex items-center justify-between gap-4 py-3.5">
                <span>{s.action}</span>
                <kbd>{s.keys}</kbd>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="privacy" class="mt-24 scroll-mt-20 bg-ink py-16 text-white sm:py-24 lg:mt-36 lg:py-28">
      <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 sm:px-6 lg:gap-14 lg:px-8">
        <h2 class="max-w-4xl text-[clamp(2.5rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.035em] text-balance">
          Veil makes no network requests.
        </h2>
        <div class="grid gap-6 border-t border-ink-line pt-8 sm:grid-cols-3">
          <div>
            <h3 class="text-lg font-bold text-brand-light sm:text-xl">Nothing leaves your browser</h3>
            <p class="mt-2 leading-relaxed text-[#c3c8db]">No analytics, no tracking and no remote code.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-brand-light sm:text-xl">Your rules stay on your device</h3>
            <p class="mt-2 leading-relaxed text-[#c3c8db]">Export them to a file when you want to move them.</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-brand-light sm:text-xl">Open source</h3>
            <p class="mt-2 leading-relaxed text-[#c3c8db]">Read every line on GitHub. Released under the MIT License.</p>
          </div>
        </div>
        <div class="max-w-3xl rounded-2xl border border-ink-line p-5 sm:p-7">
          <h3 class="font-bold sm:text-lg">What Veil cannot do</h3>
          <p class="mt-2 leading-relaxed text-[#c3c8db]">
            Veil hides data visually only. The page's own scripts can still read it. Veil cannot reach data inside
            iframes, canvas charts or images. Read the{' '}
            <a href={`${base}/privacy/`} class="text-white underline">privacy policy</a>.
          </p>
        </div>
      </div>
    </section>

    <section id="install" class="mx-auto flex max-w-7xl scroll-mt-20 flex-col gap-10 px-4 py-20 sm:px-6 lg:gap-12 lg:px-8 lg:py-28">
      <h2 class={h2}>Install Veil</h2>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="flex gap-4 border-t-2 border-ink pt-4 sm:flex-col sm:gap-3.5 sm:pt-5">
              <span class="w-6 shrink-0 text-3xl leading-none font-extrabold text-brand sm:text-[44px]">{i + 1}</span>
              <p class="leading-relaxed">
                {i === 0 ? (
                  <>
                    Download the zip from the{' '}
                    <a href={DOWNLOAD} target="_blank" rel="noopener" class="font-semibold text-brand underline hover:text-brand-deep">
                      latest release
                    </a>
                    , and unzip it into a folder that you keep.
                  </>
                ) : (
                  step
                )}
              </p>
            </li>
          ))
        }
      </ol>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
        <a href={DOWNLOAD} target="_blank" rel="noopener" class={primary}>Download for Chrome</a>
        <span class="text-[15px] text-slate-ink">
          To update, unzip the new release into the same folder and click reload on the Veil card.
        </span>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-7 gap-y-1 px-4 py-6 text-[15px] text-slate-ink sm:px-6 lg:px-8">
      <span class="flex w-full items-center gap-2 py-2 font-bold text-ink sm:w-auto">
        <Image src={icon} alt="" width={22} height={22} densities={[1, 2, 3]} class="rounded" />
        Veil
      </span>
      <span class="py-3">MIT License</span>
      <a href={`${base}/privacy/`} class="py-3 hover:text-ink">Privacy policy</a>
      <a href={`${base}/changelog/`} class="py-3 hover:text-ink">Changelog</a>
      <a href={`${REPO}/issues`} target="_blank" rel="noopener" class="py-3 hover:text-ink">Support</a>
    </div>
  </footer>
</Layout>
